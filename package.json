{
  "name": "mustardy-video-editor",
  "version": "0.1.0",
  "description": "Agentic video editor — trim silence, pan, overlay. Native local models via llama.cpp/whisper.cpp, optional Kimi.",
  "author": "Mustardy",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "prep": "node scripts/prep.mjs",
    "pack:mac": "node scripts/prep.mjs && tauri build",
    "pack:linux": "node scripts/prep.mjs && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
