{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capability set for Mustardy",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir"
  ]
}
